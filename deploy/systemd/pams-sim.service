[Unit]
Description=PAMS freezer simulator (30 units -> MQTT)
After=network-online.target docker.service
Wants=network-online.target
# Never run while the live BMS node is active (keeps sim data out of the pilot):
Conflicts=pams-bms.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin
EnvironmentFile=-/home/admin/pams.env
ExecStart=/home/admin/pams_env/bin/python /home/admin/mock_freezer_data.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
