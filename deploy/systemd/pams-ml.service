[Unit]
Description=PAMS ML scoring service (MQTT IsolationForest)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin
EnvironmentFile=-/home/admin/pams.env
ExecStart=/home/admin/pams_env/bin/python /home/admin/pams_ml_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
