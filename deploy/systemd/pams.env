# Shared environment for PAMS systemd services.
# After editing:  sudo systemctl restart pams-ml
MQTT_HOST=localhost
MQTT_PORT=1883

# Stream service logs in real time (no stdout buffering under systemd).
PYTHONUNBUFFERED=1

# ML baseline: number of points before real anomaly scoring begins.
#   60     = ~1 hour for the real BMS (1 reading/min)
#   10080  = 1 week for the real BMS (1 reading/min)
PAMS_ML_BASELINE=60

# Optional REAL BMS soft-sensors for the BMS node to read + publish (comma list
# of name=objtype:instance). Each is read every poll; whatever answers flows into
# MQTT and the ML ingests it automatically (level + rate per channel). Absent
# sensors are simply skipped - nothing is fabricated. Recognized names:
#   evaporator_temp return_air_temp ambient_temp condenser_temp
#   suction_pressure discharge_pressure superheat compressor_current
#   humidity setpoint defrost_status compressor_status
# MS/TP objtypes use dashed names (analog-input); BACnet/IP uses camelCase (analogInput).
# PAMS_EXTRA_POINTS=evaporator_temp=analog-input:2,suction_pressure=analog-input:3,defrost_status=binary-input:2
