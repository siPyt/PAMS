# Shared environment for PAMS systemd services.
# After editing:  sudo systemctl restart pams-ml
MQTT_HOST=localhost
MQTT_PORT=1883

# Stream service logs in real time (no stdout buffering under systemd).
PYTHONUNBUFFERED=1

# ML baseline: number of points before real anomaly scoring begins.
#   60     = ~1 hour for the real BMS (1 reading/min)
#   10080  = 1 week for the real BMS (1 reading/min)
PAMS_ML_BASELINE=60
