# Shared environment for PAMS systemd services.
# After editing:  sudo systemctl restart pams-ml pams-sim
MQTT_HOST=localhost
MQTT_PORT=1883

# ML baseline: number of points before real anomaly scoring begins.
#   60     = ~1 minute for the simulator demo (1 reading/sec)
#   10080  = 1 week for the real BMS (1 reading/min)
PAMS_ML_BASELINE=60
