[
    {
        "id": "pams-tab",
        "type": "tab",
        "label": "PAMS Ingest",
        "disabled": false,
        "info": "MQTT (pams/freezers/+) -> build InfluxDB point -> write to bucket 'freezer_data'."
    },
    {
        "id": "mqttbroker1",
        "type": "mqtt-broker",
        "name": "field-mqtt",
        "broker": "mqtt",
        "port": "1883",
        "clientid": "node-red-pams",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "sessionExpiry": ""
    },
    {
        "id": "influx-config",
        "type": "influxdb",
        "hostname": "127.0.0.1",
        "port": "8086",
        "protocol": "http",
        "database": "database",
        "name": "field-influxdb",
        "usetls": false,
        "tls": "",
        "influxdbVersion": "2.0",
        "url": "http://influxdb:8086",
        "rejectUnauthorized": true
    },
    {
        "id": "mqtt-in",
        "type": "mqtt in",
        "z": "pams-tab",
        "name": "pams/freezers/+",
        "topic": "pams/freezers/+",
        "qos": "0",
        "datatype": "json",
        "broker": "mqttbroker1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 160,
        "wires": [
            [
                "fn-build"
            ]
        ]
    },
    {
        "id": "fn-build",
        "type": "function",
        "z": "pams-tab",
        "name": "build influx point",
        "func": "// Adaptive: write EVERY numeric field present, so InfluxDB gets exactly\n// the points the BMS actually provided (2, 11, or all 14 - never fabricated).\nconst r = msg.payload;\nif (!r || typeof r !== 'object') { return null; }\nconst skip = { unit_id: 1, ts: 1, channels: 1, models: 1, n_features: 1, n_points: 1 };\nconst fields = {};\nfor (const k in r) {\n    if (skip[k]) { continue; }\n    const v = r[k];\n    if (v === null || v === undefined) { continue; }\n    const n = Number(v);\n    if (!Number.isNaN(n)) { fields[k] = n; }\n}\nif (Object.keys(fields).length === 0) { return null; }\nconst unit = String(r.unit_id || (msg.topic ? msg.topic.split('/').pop() : 'unknown'));\nmsg.payload = [fields, { unit_id: unit }];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 160,
        "wires": [
            [
                "influx-out",
                "dbg"
            ]
        ]
    },
    {
        "id": "influx-out",
        "type": "influxdb out",
        "z": "pams-tab",
        "influxdb": "influx-config",
        "name": "write readings",
        "measurement": "readings",
        "precision": "",
        "retentionPolicy": "",
        "database": "database",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "PAMS_demo",
        "bucket": "freezer_data",
        "x": 660,
        "y": 140,
        "wires": []
    },
    {
        "id": "dbg",
        "type": "debug",
        "z": "pams-tab",
        "name": "readings",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 650,
        "y": 200,
        "wires": []
    },
    {
        "id": "comment-info",
        "type": "comment",
        "z": "pams-tab",
        "name": "Enter InfluxDB token in the 'field-influxdb' config node, then Deploy",
        "info": "Open the 'write readings' node -> pencil next to Server -> Token = your InfluxDB API token (org PAMS_demo). Deploy.",
        "x": 340,
        "y": 80,
        "wires": []
    },
    {
        "id": "mqtt-in-scored",
        "type": "mqtt in",
        "z": "pams-tab",
        "name": "pams/scored/+",
        "topic": "pams/scored/+",
        "qos": "0",
        "datatype": "json",
        "broker": "mqttbroker1",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 320,
        "wires": [
            [
                "fn-ml-build"
            ]
        ]
    },
    {
        "id": "fn-ml-build",
        "type": "function",
        "z": "pams-tab",
        "name": "build ML influx point",
        "func": "// Adaptive: write EVERY numeric field present in the scored record (health,\n// per-model scores, RUL, plus whatever real soft-sensors were echoed through).\nconst r = msg.payload;\nif (!r || typeof r !== 'object') { return null; }\nconst skip = { unit_id: 1, ts: 1, channels: 1, models: 1, n_features: 1, n_points: 1 };\nconst fields = {};\nfor (const k in r) {\n    if (skip[k]) { continue; }\n    const v = r[k];\n    if (v === null || v === undefined) { continue; }\n    const n = Number(v);\n    if (!Number.isNaN(n)) { fields[k] = n; }\n}\nif (Object.keys(fields).length === 0) { return null; }\nconst unit = String(r.unit_id || (msg.topic ? msg.topic.split('/').pop() : 'unknown'));\nmsg.payload = [fields, { unit_id: unit }];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 320,
        "wires": [
            [
                "influx-ml-out",
                "dbg-ml"
            ]
        ]
    },
    {
        "id": "influx-ml-out",
        "type": "influxdb out",
        "z": "pams-tab",
        "influxdb": "influx-config",
        "name": "write ml_scores",
        "measurement": "ml_scores",
        "precision": "",
        "retentionPolicy": "",
        "database": "database",
        "precisionV18FluxV20": "ms",
        "retentionPolicyV18Flux": "",
        "org": "PAMS_demo",
        "bucket": "freezer_data",
        "x": 670,
        "y": 300,
        "wires": []
    },
    {
        "id": "dbg-ml",
        "type": "debug",
        "z": "pams-tab",
        "name": "ml_scores",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 660,
        "y": 360,
        "wires": []
    }
]
